<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GalgameManager.Views.AnnualReportSubPage6"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prefab="using:GalgameManager.Views.Prefab"
    xmlns:viewModels="using:GalgameManager.ViewModels"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    xmlns:behaviors="using:GalgameManager.Behaviors"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="在每个月，我最喜欢..."
                   Style="{ThemeResource SubtitleTextBlockStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,20"
                   Visibility="{x:Bind ViewModel.AnnualReportData.HasPlayData, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibilityConverter}}"/>

        <GridView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.MonthlyBestGames}"
                  SelectionMode="None"
                  HorizontalAlignment="Center"
                  Visibility="{x:Bind ViewModel.AnnualReportData.HasPlayData, Mode=OneWay,
                                      Converter={StaticResource BoolToVisibilityConverter}}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:MonthlyBestGame">
                    <Grid Width="200" Height="330" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock 
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10">
                            <Run Text="{x:Bind Month}"/>
                            <Run Text="月"/>
                        </TextBlock>
                        
                        <prefab:GalgamePrefab Grid.Row="1"
                                              Galgame="{x:Bind Game}"
                                              ImageStretch="UniformToFill"/>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- 今年一部都没玩过：没有月度之星，给空态 -->
        <TextBlock Grid.Row="1"
                   x:Uid="AnnualReportPage_NoData"
                   Style="{ThemeResource SubtitleTextBlockStyle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Visibility="{x:Bind ViewModel.AnnualReportData.HasPlayData, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibilityConverter},
                                       ConverterParameter=true}"/>
    </Grid>
</Page>

