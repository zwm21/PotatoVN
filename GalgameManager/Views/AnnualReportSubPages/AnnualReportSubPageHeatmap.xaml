<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GalgameManager.Views.AnnualReportSubPageHeatmap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    xmlns:heatmap="using:GalgameManager.Helpers"
    xmlns:cmtkConverter="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:ImagePathConverter x:Key="ImagePathConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <cmtkConverter:StringFormatConverter x:Key="StrFmt"/>
    </Page.Resources>

    <Grid Margin="{StaticResource SmallRightMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：范围汇总标题 + 范围切换 -->
        <Grid Grid.Row="0" Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.RangeSummary, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <ComboBox Grid.Column="1"
                      MinWidth="130"
                      VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.RangeOptions, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedRange, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"/>
        </Grid>

        <!-- 四张指标卡 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <control:Panel Grid.Column="0" Margin="4" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_TotalPlayTime"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalPlayTimeText, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </control:Panel>

            <control:Panel Grid.Column="1" Margin="4" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_ActiveDays"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.ActiveDays, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_UnitDay"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Opacity="0.7"/>
                </StackPanel>
            </control:Panel>

            <control:Panel Grid.Column="2" Margin="4" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_LongestStreak"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.LongestStreak, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_UnitDay"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Opacity="0.7"/>
                </StackPanel>
            </control:Panel>

            <control:Panel Grid.Column="3" Margin="4" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_CurrentStreak"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentStreak, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_UnitDay"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Opacity="0.7"/>
                </StackPanel>
            </control:Panel>
        </Grid>

        <!-- GitHub 风格热力图 -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Uid="AnnualReportPage_Heatmap_CardTitle"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 星期标签：下移一个月份行高度，与格子行顶部对齐 -->
                    <Grid Grid.Column="0" x:Name="WeekdayHost"
                          VerticalAlignment="Top"
                          Margin="0,20,6,0"/>
                    <!-- 窄窗口可横向滚动，不压扁格子 -->
                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Disabled">
                        <Grid x:Name="HeatmapHost"/>
                    </ScrollViewer>
                </Grid>

                <!-- 图例：少 □ □ □ □ □ 多 -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_LegendLess"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.7"
                               Margin="0,0,6,0"/>
                    <Border Width="12" Height="12" CornerRadius="2" Margin="2"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                    <Border Width="12" Height="12" CornerRadius="2" Margin="2">
                        <Border.Background>
                            <SolidColorBrush Color="#9BE9A8"/>
                        </Border.Background>
                    </Border>
                    <Border Width="12" Height="12" CornerRadius="2" Margin="2">
                        <Border.Background>
                            <SolidColorBrush Color="#40C463"/>
                        </Border.Background>
                    </Border>
                    <Border Width="12" Height="12" CornerRadius="2" Margin="2">
                        <Border.Background>
                            <SolidColorBrush Color="#30A14E"/>
                        </Border.Background>
                    </Border>
                    <Border Width="12" Height="12" CornerRadius="2" Margin="2">
                        <Border.Background>
                            <SolidColorBrush Color="#216E39"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_LegendMore"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.7"
                               Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 当日游玩明细 -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Uid="AnnualReportPage_Heatmap_DayDetail"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_SelectedDate"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedDateText, Mode=OneWay}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_DayTotal"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.7"
                               Margin="16,0,0,0"/>
                    <TextBlock Text="{x:Bind ViewModel.DayTotalText, Mode=OneWay}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- 当天无记录：简洁空态 -->
                <TextBlock Grid.Row="2"
                           x:Uid="AnnualReportPage_Heatmap_DayEmpty"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           Visibility="{x:Bind ViewModel.HasDayRecord, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibilityConverter},
                                       ConverterParameter=true}"/>

                <ScrollViewer Grid.Row="2"
                              Visibility="{x:Bind ViewModel.HasDayRecord, Mode=OneWay,
                                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.DayGames, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="heatmap:DailyGamePlayItem">
                                <Grid Margin="0,2" ColumnDefinitions="Auto,Auto,*">
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="4"
                                            Margin="0,0,8,0"
                                            Visibility="{x:Bind HasCover, Mode=OneWay}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind CoverPath, Mode=OneWay,
                                                        Converter={StaticResource ImagePathConverter},
                                                        FallbackValue={x:Null}}"
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind GameName, Mode=OneWay}"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Minutes, Mode=OneWay}"
                                                   Style="{ThemeResource BodyTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Uid="AnnualReportPage_Heatmap_GameMinutes"
                                                   Style="{ThemeResource BodyTextBlockStyle}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.7"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
