<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GalgameManager.Views.AnnualReportSubPageHeatmap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    xmlns:heatmap="using:GalgameManager.Helpers"
    xmlns:viewModels="using:GalgameManager.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:ImagePathConverter x:Key="ImagePathConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="{StaticResource SmallRightMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：范围汇总标题 + 范围切换 -->
        <Grid Grid.Row="0" Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.RangeSummary, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <ComboBox Grid.Column="1"
                      MinWidth="130"
                      VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.RangeOptions, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedRange, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"/>
        </Grid>

        <!-- 四张指标卡：左对齐、紧凑内边距、上标题下数值 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="4,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="12,8">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_TotalPlayTime"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalPlayTimeText, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="Bold"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="4,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="12,8">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_ActiveDays"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{x:Bind ViewModel.ActiveDays, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold"/>
                        <TextBlock x:Uid="AnnualReportPage_Heatmap_UnitDay"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="4,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="12,8">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_LongestStreak"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{x:Bind ViewModel.LongestStreak, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold"/>
                        <TextBlock x:Uid="AnnualReportPage_Heatmap_UnitDay"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Margin="4,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="12,8">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_CurrentStreak"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{x:Bind ViewModel.CurrentStreak, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold"/>
                        <TextBlock x:Uid="AnnualReportPage_Heatmap_UnitDay"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- GitHub 风格热力图 -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Uid="AnnualReportPage_Heatmap_CardTitle"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 星期标签：下移一个月份行高度，与格子行顶部对齐 -->
                    <Grid Grid.Column="0" x:Name="WeekdayHost"
                          VerticalAlignment="Top"
                          Margin="0,20,6,0"/>
                    <!-- 窄窗口可横向滚动，不压扁格子 -->
                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Disabled">
                        <Grid x:Name="HeatmapHost"/>
                    </ScrollViewer>
                </Grid>

                    <!-- 图例：少 □ □ □ □ □ 多。色块与格子共用同一套主题色板 -->
                    <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                        <TextBlock x:Uid="AnnualReportPage_Heatmap_LegendLess"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.7"
                               Margin="0,0,6,0"/>
                        <Border Width="12" Height="12" CornerRadius="2" Margin="2"
                                Background="{x:Bind ViewModel.Level0Brush, Mode=OneWay}"/>
                        <Border Width="12" Height="12" CornerRadius="2" Margin="2"
                                Background="{x:Bind ViewModel.Level1Brush, Mode=OneWay}"/>
                        <Border Width="12" Height="12" CornerRadius="2" Margin="2"
                                Background="{x:Bind ViewModel.Level2Brush, Mode=OneWay}"/>
                        <Border Width="12" Height="12" CornerRadius="2" Margin="2"
                                Background="{x:Bind ViewModel.Level3Brush, Mode=OneWay}"/>
                        <Border Width="12" Height="12" CornerRadius="2" Margin="2"
                                Background="{x:Bind ViewModel.Level4Brush, Mode=OneWay}"/>
                        <TextBlock x:Uid="AnnualReportPage_Heatmap_LegendMore"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.7"
                               Margin="6,0,0,0"/>
                    </StackPanel>

                <!--
                  浮动悬停提示层：覆盖整卡、不拦截命中、默认隐藏。
                  取代原生 ToolTip（其弹出延迟无法关闭），由 PointerEntered 直接定位，
                  实现 0ms 零延迟跟随。
                -->
                <Canvas Grid.Row="0" Grid.RowSpan="3"
                        x:Name="TipCanvas"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border x:Name="TipBorder"
                            Visibility="Collapsed"
                            Padding="8,5"
                            CornerRadius="4"
                            Translation="0,0,4"
                            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Border.Shadow>
                            <ThemeShadow/>
                        </Border.Shadow>
                        <TextBlock x:Name="TipText"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextWrapping="NoWrap"/>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!-- 当日游玩明细 -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Uid="AnnualReportPage_Heatmap_DayDetail"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_SelectedDate"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedDateText, Mode=OneWay}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                    <TextBlock x:Uid="AnnualReportPage_Heatmap_DayTotal"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.7"
                               Margin="16,0,0,0"/>
                    <TextBlock Text="{x:Bind ViewModel.DayTotalText, Mode=OneWay}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- 当天无记录：简洁空态 -->
                <TextBlock Grid.Row="2"
                           x:Uid="AnnualReportPage_Heatmap_DayEmpty"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           Visibility="{x:Bind ViewModel.HasDayRecord, Mode=OneWay,
                                       Converter={StaticResource BoolToVisibilityConverter},
                                       ConverterParameter=true}"/>

                <ScrollViewer Grid.Row="2"
                              Visibility="{x:Bind ViewModel.HasDayRecord, Mode=OneWay,
                                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.DayGames, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:HeatmapDayGameItem">
                                <Grid Margin="0,2" ColumnDefinitions="Auto,Auto,*,Auto">
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="4"
                                            Margin="0,0,8,0"
                                            Visibility="{x:Bind HasCover, Mode=OneWay}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind CoverPath, Mode=OneWay,
                                                        Converter={StaticResource ImagePathConverter},
                                                        FallbackValue={x:Null}}"
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind GameName, Mode=OneWay}"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               MaxWidth="420"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind DurationText, Mode=OneWay}"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
