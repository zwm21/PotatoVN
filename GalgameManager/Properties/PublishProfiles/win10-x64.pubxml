<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>True</SelfContained>
    <PublishSingleFile>False</PublishSingleFile>
    <!--
      ReadyToRun 已关闭。实测：开 R2R 的便携包 244.41 MiB，关掉后 209.15 MiB，
      净省 35.26 MiB（其中 Microsoft.WinUI.dll 一家就占 8.99 MiB）。
      代价只是冷启动时那部分代码要现 JIT——WinUI 应用的启动瓶颈本来在 XAML 解析与
      合成器初始化，实测体感差异需要实机确认；若明显变慢，把下面这行改回 true 即可。
    -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <!--
    原先这里有一条 <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />：
    该程序集是 C#/WinRT 投影，R2R 预编译会让它从 26,086,944 B 膨胀到 59,498,496 B，
    而它极少被热调用，预编译收益极小。R2R 整体关闭后这条豁免已无对象，故移除；
    记录留在这里是因为 Microsoft.Windows.SDK.NET.dll 仍是包里最大的单个文件，
    后续若重新打开 R2R，需要把这条加回来。
  -->
</Project>
