<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GalgameManager</RootNamespace>
    <ApplicationIcon>Assets/WindowIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>Properties\PublishProfiles\win10-$(Platform).pubxml</PublishProfile>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <DefaultLanguage>zh-cn</DefaultLanguage>
    <AppxPackageDir>.\Build\</AppxPackageDir>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxBundlePlatforms>x86|x64</AppxBundlePlatforms>
    <!-- 打 bundle（商店包）时不按语言拆分资源包：VS 会把语言资源包全部过滤掉，只剩 zh-CN 的 WinUI
         Microsoft.ui.xaml.dll.mui 与应用字符串，其他系统语言下控件加载本地化资源时抛出
         0x80073B01（ERROR_MUI_FILE_NOT_LOADED）而崩溃（issue #742）。因此只按缩放比例拆分 -->
    <AppxBundleAutoResourcePackageQualifiers>Scale|DXFeatureLevel</AppxBundleAutoResourcePackageQualifiers>
    <!-- TODO: 要处理该警告需要用到.Net Preview的特性，等特性稳定（进入正式版）后再处理 -->
    <NoWarn>MVVMTK0045</NoWarn>

    <!-- 关闭WinAppSDK自动初始化，手动在App里初始化（为了测试能正常运行） -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <WindowsAppSdkCompatibilityInitialize>false</WindowsAppSdkCompatibilityInitialize>
    <!-- 编入 Microsoft.WindowsAppSDK.Release 等版本常量，供手动 Bootstrap 使用，避免硬编码运行时版本 -->
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>

    <!-- 使用自定义入口（在 Application.Start 之前初始化 WinAppRuntime） -->
    <StartupObject>GalgameManager.BootstrapProgram</StartupObject>
  </PropertyGroup>

  <!--
    自包含便携分发：把 Windows App SDK 运行时一起打包进输出目录，目标机无需安装 Windows App Runtime。
    仅在显式指定 PotatoVnPortable=true 时开启——该属性不能通过命令行全局传入，
    否则会传播到引用的类库项目并触发 "WindowsAppSDKSelfContained should not be applied to a class library"。
  -->
  <PropertyGroup Condition="'$(PotatoVnPortable)' == 'true'">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!--
    便携发布专用：定向裁剪，只放开 BCL 与 WinRT 投影参与 partial 裁剪。

    严格限定在 PotatoVnPortable=true 且 Release 下生效——也就是只有
    BuildScripts/Publish-Portable.ps1 那条命令链会走到。普通 Debug 构建、dotnet test
    （测试项目引用本工程时既不带 PotatoVnPortable 也不是 Release）完全不受影响，
    不参与 trim 分析、不拖慢日常编译。

    裁剪范围（T1）：
      * link（交给 trimmer）：.NET 运行时包里标记 IsTrimmable 的 BCL 程序集
        + Microsoft.Windows.SDK.NET.dll（26,086,944 B -> 959,488 B）
      * copy（原样拷贝、不分析不改代码）：29 个业务/第三方程序集
        （GalgameManager* / LiteDB / Newtonsoft.Json / Refit / SQLite-net /
        CommunityToolkit.* / SharpCompress / SevenZipSharp / LiveChartsCore* / SkiaSharp*）
        以及全部 WinAppSDK / WinUI 托管投影（Microsoft.WinUI.dll /
        Microsoft.InteractiveExperiences.Projection.dll 等）
    实测 T1 后未压缩 172.17 -> 128.50 MiB（省 43.67 MiB）；上述 29 个程序集与
    GalgameManager.WinApp.Base 的公开 API 表面积（80 导出类型 / 1097 公开成员 /
    78 个外部签名类型）逐字节 / 逐条不变。

    两个必须记住的机制：
      * TrimMode=partial 下不给元数据等于不处理，所以必须显式给想裁的程序集设 link，
        不能只是"不设 copy"（早期版本踩过：那样 T1/T2 与不裁逐字节相同）。
      * 钩子挂 PrepareForILLink 的 AfterTargets——microsoft.net.illink.tasks 的
        Microsoft.NET.ILLink.targets 里该目标的注释明确写着这就是给外部改 per-assembly
        IsTrimmable / TrimMode 的扩展点。

    剩余风险（无法离线验证）：第三方插件经 AssemblyLoadContext 加载后，可能调用主程序
    未静态引用的 BCL API。BCL 被裁掉未被直接引用的类型，这类调用会抛
    MissingMethodException / FileNotFoundException。已用探针工程离线验证 17 条高危路径
    全部存活（dynamic x3、表达式树、Activator.CreateInstance、GetInterfaces、
    Assembly.GetTypes、AssemblyLoadContext.LoadFromAssemblyPath、LiteDB、
    Newtonsoft 自定义 Converter、TypeDescriptor 排序、sqlite-net-pcl ORM），
    但插件动态调用这一项只能靠实机压测。
  -->
  <PropertyGroup Condition="'$(PotatoVnPortable)' == 'true' And '$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!--
      必须显式打开：PublishTrimmed=true 时 microsoft.net.illink.tasks 的
      Microsoft.NET.ILLink.targets 会把 BuiltInComInteropSupport 默认成 false
      （"Features are disabled by default since they may require assemblies,
      types or members that could be removed by the ILLink"），该值经
      Microsoft.NET.Sdk.targets 映射成运行期开关
      System.Runtime.InteropServices.BuiltInComInterop.IsSupported=false，
      于是 Type.GetTypeFromCLSID / GetTypeFromProgID 直接抛
      "Built-in COM has been disabled via a feature switch"。

      受影响的三处实机路径：
        * Helpers/PvnFsPicker.cs:88 —— Type.GetTypeFromCLSID(CLSID_FileOpenDialog)
          + Activator.CreateInstance，便携包的文件夹/文件选择器全部走这里，
          点「选择备份保存位置」即崩（用户实机复现）。
        * ViewModels/SettingsViewModel.cs:1051 —— Type.GetTypeFromProgID("WScript.Shell")
          + Activator.CreateInstance，创建桌面快捷方式。
        * Models/BgTasks/GameMuteTask.cs:108/263 —— [ComImport] class MMDeviceEnumerator 的
          new 实例化（Windows Core Audio 静音任务，随游戏启动自动挂上）。
          它不经过 GetTypeFromCLSID，但同一个开关同样管它。

      已用独立探针工程（PublishTrimmed=true + TrimMode=partial，逐条复刻上述写法）
      实测：只开本属性、EnableGeneratedComInterfaceComImportInterop 仍为 false 时，
      GetTypeFromCLSID / GetTypeFromProgID / [ComImport] class new / [ComImport] 接口
      完整调用链（GetDefaultAudioEndpoint -> Activate，hr 均为 0）全部通过；
      再补开 EnableGeneratedComInterfaceComImportInterop 行为无变化，故不额外加它
      ——那是 [GeneratedComInterface] 源生成封送路径的开关，本仓库用不到。

      只裁 BCL 的范围不改变这个结论：COM 激活不在 ILLink 的静态引用图里，
      TrimMode=copy 的业务程序集原样拷贝，运行时照样要调这些 API。
      体积代价实测为 0（两次全量便携构建仅 runtimeconfig.json 差 1 字节）。
    -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <!--
    BCL 清单动态生成：从 NuGet 缓存的 .NET 8 运行时包 glob，不写死。
    路径限定 8.0.*\runtimes\win-x64\lib\net8.0，因此 9.x / 10.0 的包不会混进来。
    Distinct 防止本机缓存里同时存在多个 8.0.x 版本时产生重复项。
    取纯文件名（不含扩展名）是为了与下方 JoinItems 的 LeftKey="FileName" 对应。
  -->
  <ItemGroup Condition="'$(PotatoVnPortable)' == 'true' And '$(Configuration)' == 'Release'">
    <_BclTrim Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.win-x64\8.0.*\runtimes\win-x64\lib\net8.0\*.dll" />
    <_BclName Include="@(_BclTrim->'%(Filename)'->Distinct())" />
    <_BclName Include="Microsoft.Windows.SDK.NET" />
  </ItemGroup>
  <Target Name="ScopeTrimToBcl"
          AfterTargets="PrepareForILLink"
          Condition="'$(PotatoVnPortable)' == 'true' And '$(Configuration)' == 'Release'">
    <ItemGroup>
      <!-- 1) 先全部设 copy -->
      <ManagedAssemblyToLink><TrimMode>copy</TrimMode></ManagedAssemblyToLink>
    </ItemGroup>
    <!-- 2) 把 BCL + SDK.NET 挑出来设回 link。
         复刻 SDK 自己处理 TrimmableAssembly 的写法（见 Microsoft.NET.ILLink.targets
         的 PrepareForILLink：JoinItems LeftKey="FileName" + Right=TrimmableAssembly）。 -->
    <JoinItems Left="@(ManagedAssemblyToLink)" LeftKey="FileName" LeftMetadata="*"
               Right="@(_BclName)" RightKey="" RightMetadata="" ItemSpecToUse="Left">
      <Output TaskParameter="JoinResult" ItemName="_KeepTrim" />
    </JoinItems>
    <ItemGroup>
      <ManagedAssemblyToLink Remove="@(_KeepTrim)" />
      <ManagedAssemblyToLink Include="@(_KeepTrim)" TrimMode="link" />
    </ItemGroup>
    <Message Importance="high"
             Text="ScopeTrimToBcl: 参与链接 @(ManagedAssemblyToLink->Count()) 个程序集，其中 link @(ManagedAssemblyToLink->WithMetadataValue('TrimMode','link')->Count()) 个（BCL + WinRT 投影），copy @(ManagedAssemblyToLink->WithMetadataValue('TrimMode','copy')->Count()) 个（业务/第三方/WinAppSDK 托管投影）" />
  </Target>

  <!-- 从 Package.appxmanifest 读取 Identity Version，供程序集版本属性与动态版本共用 -->
  <Target Name="ReadMsixIdentityVersion" Condition="Exists('$(MSBuildProjectDirectory)\Package.appxmanifest')">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="_MsixIdentityVersion" />
    </XmlPeek>
  </Target>

  <!--
    - MSIX 模式下 RuntimeHelper.GetVersion() 读取 Package.appxmanifest 的 Identity Version
    - 便携/非 MSIX 模式下读取程序集版本
    三个版本属性统一取动态版本号（manifest 前三段 + 第 4 段叠加"自 manifest 改动以来的提交数"），
    与分发目录名 PotatoVN-<动态版本>-<平台>-portable 完全一致，便于区分同基础版本的每次构建。
    动态版本取不到时（无 git / 无 PowerShell / 未生成资源文件）回落到 manifest 的基础版本。
  -->
  <Target Name="DeriveAssemblyVersionFromMsixManifest"
          DependsOnTargets="GenerateBuildVersionInfo;ReadMsixIdentityVersion"
          BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <_EffectiveVersion Condition="'$(_DynamicVersion)' != ''">$(_DynamicVersion)</_EffectiveVersion>
      <_EffectiveVersion Condition="'$(_EffectiveVersion)' == ''">$(_MsixIdentityVersion)</_EffectiveVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_EffectiveVersion)' != ''">
      <AssemblyVersion>$(_EffectiveVersion)</AssemblyVersion>
      <FileVersion>$(_EffectiveVersion)</FileVersion>
      <InformationalVersion>$(_EffectiveVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!--
    动态版本：构建期把 git 采集结果写入 obj 下的资源文件，并以嵌入资源编入程序集；
    运行期只读该资源（Helpers/AppVersion.cs），因此运行时不需要 git、也不使用时间戳，
    同一份源码在任何机器上得到的版本一致。采集脚本见 BuildScripts/Get-BuildVersionInfo.ps1。
    采集失败（无 git / 无 PowerShell / 非 git 目录）时不中断构建，运行期回退到 +src.unknown。
  -->
  <Target Name="GenerateBuildVersionInfo" DependsOnTargets="ReadMsixIdentityVersion" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_BuildVersionInfoPath>$(IntermediateOutputPath)BuildVersionInfo.txt</_BuildVersionInfoPath>
      <_BuildVersionInfoArgs>-NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)BuildScripts\Get-BuildVersionInfo.ps1" -BaseVersion "$(_MsixIdentityVersion)" -StartDir "$(MSBuildProjectDirectory)" -ManifestPath "$(MSBuildProjectDirectory)\Package.appxmanifest" -OutputPath "$(_BuildVersionInfoPath)"</_BuildVersionInfoArgs>
    </PropertyGroup>
    <!-- 优先 pwsh，PATH 里没有时回退到 Windows 自带的 powershell.exe -->
    <Exec Command="pwsh $(_BuildVersionInfoArgs) || powershell.exe $(_BuildVersionInfoArgs)"
          ContinueOnError="true" IgnoreExitCode="true" />
    <Message Condition="!Exists('$(_BuildVersionInfoPath)')" Importance="high"
             Text="未能生成动态版本资源 $(_BuildVersionInfoPath)，运行时将回退到 +src.unknown。" />
    <!-- 把动态版本号读回 MSBuild 属性，供 DeriveAssemblyVersionFromMsixManifest 写入 exe 的文件版本/产品版本 -->
    <ReadLinesFromFile File="$(_BuildVersionInfoPath)" Condition="Exists('$(_BuildVersionInfoPath)')">
      <Output TaskParameter="Lines" ItemName="_BuildVersionInfoLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_BuildVersionInfoLine>@(_BuildVersionInfoLines)</_BuildVersionInfoLine>
      <!-- 资源行格式 base|commits|commit|[delta]，第一段即动态版本号 -->
      <_DynamicVersion>$([System.Text.RegularExpressions.Regex]::Match($(_BuildVersionInfoLine), '^[^|]+').Value)</_DynamicVersion>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_BuildVersionInfoPath)')">
      <EmbeddedResource Include="$(_BuildVersionInfoPath)">
        <LogicalName>GalgameManager.BuildVersionInfo.txt</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Remove="Assets\Pictures\icon-dev\*" />
    <Content Update="Assets\Data\vn_mapper.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\Pictures\Akkarin.webp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      三个 JSON 数据文件随包发 gzip 版（Assets\Data\*.json.gz），运行期由 GzipJsonFile 流式解压。
      未压缩的 *.json 仍留在仓库里作为源数据（改数据改它，再重新生成 .gz），
      但不参与发布、也不进测试输出目录；GzipJsonFileTest 会校验 .gz 解压后与 .json 逐字节一致。
      压缩前合计 2.51 MiB，压缩后 0.64 MiB，净省 1.87 MiB。
    -->
    <Content Update="Assets\Data\vndb-tags-latest.json.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\Data\vndb-tags-translation.json.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\Data\producers.json.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Remove="Assets\Data\vndb-tags-latest.json" />
    <Content Remove="Assets\Data\vndb-tags-translation.json" />
    <Content Remove="Assets\Data\producers.json" />
    <Content Update="Assets\Libs\x64\7za.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\Pictures\bangumi.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\Pictures\Potato.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\Pictures\vndb.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\WindowIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 以下三个文件不在默认 Content glob 内（WinUI 项目只收显式声明的资产），
         漏掉会导致发布包里没有角色默认头像、跳转列表图标与 Win10 字体安装入口。
         Debug 构建走全量 glob 看不出问题，只有 Release publish 会丢。 -->
    <Content Update="Assets\default_character.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\heart.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\Fonts\Segoe Fluent Icons.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
