<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GalgameManager</RootNamespace>
    <ApplicationIcon>Assets/WindowIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>Properties\PublishProfiles\win10-$(Platform).pubxml</PublishProfile>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <DefaultLanguage>zh-cn</DefaultLanguage>
    <AppxPackageDir>.\Build\</AppxPackageDir>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxBundlePlatforms>x86|x64</AppxBundlePlatforms>
    <!-- 打 bundle（商店包）时不按语言拆分资源包：VS 会把语言资源包全部过滤掉，只剩 zh-CN 的 WinUI
         Microsoft.ui.xaml.dll.mui 与应用字符串，其他系统语言下控件加载本地化资源时抛出
         0x80073B01（ERROR_MUI_FILE_NOT_LOADED）而崩溃（issue #742）。因此只按缩放比例拆分 -->
    <AppxBundleAutoResourcePackageQualifiers>Scale|DXFeatureLevel</AppxBundleAutoResourcePackageQualifiers>
    <!-- TODO: 要处理该警告需要用到.Net Preview的特性，等特性稳定（进入正式版）后再处理 -->
    <NoWarn>MVVMTK0045</NoWarn>

    <!-- 关闭WinAppSDK自动初始化，手动在App里初始化（为了测试能正常运行） -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <WindowsAppSdkCompatibilityInitialize>false</WindowsAppSdkCompatibilityInitialize>
    <!-- 编入 Microsoft.WindowsAppSDK.Release 等版本常量，供手动 Bootstrap 使用，避免硬编码运行时版本 -->
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>

    <!-- 使用自定义入口（在 Application.Start 之前初始化 WinAppRuntime） -->
    <StartupObject>GalgameManager.BootstrapProgram</StartupObject>
  </PropertyGroup>

  <!--
    自包含便携分发：把 Windows App SDK 运行时一起打包进输出目录，目标机无需安装 Windows App Runtime。
    仅在显式指定 PotatoVnPortable=true 时开启——该属性不能通过命令行全局传入，
    否则会传播到引用的类库项目并触发 "WindowsAppSDKSelfContained should not be applied to a class library"。
  -->
  <PropertyGroup Condition="'$(PotatoVnPortable)' == 'true'">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- 从 Package.appxmanifest 读取 Identity Version，供程序集版本属性与动态版本共用 -->
  <Target Name="ReadMsixIdentityVersion" Condition="Exists('$(MSBuildProjectDirectory)\Package.appxmanifest')">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="_MsixIdentityVersion" />
    </XmlPeek>
  </Target>

  <!--
    - MSIX 模式下 RuntimeHelper.GetVersion() 读取 Package.appxmanifest 的 Identity Version
    - 便携/非 MSIX 模式下读取程序集版本
    三个版本属性统一取动态版本号（manifest 前三段 + 第 4 段叠加"自 manifest 改动以来的提交数"），
    与分发目录名 PotatoVN-<动态版本>-<平台>-portable 完全一致，便于区分同基础版本的每次构建。
    动态版本取不到时（无 git / 无 PowerShell / 未生成资源文件）回落到 manifest 的基础版本。
  -->
  <Target Name="DeriveAssemblyVersionFromMsixManifest"
          DependsOnTargets="GenerateBuildVersionInfo;ReadMsixIdentityVersion"
          BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <_EffectiveVersion Condition="'$(_DynamicVersion)' != ''">$(_DynamicVersion)</_EffectiveVersion>
      <_EffectiveVersion Condition="'$(_EffectiveVersion)' == ''">$(_MsixIdentityVersion)</_EffectiveVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_EffectiveVersion)' != ''">
      <AssemblyVersion>$(_EffectiveVersion)</AssemblyVersion>
      <FileVersion>$(_EffectiveVersion)</FileVersion>
      <InformationalVersion>$(_EffectiveVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!--
    动态版本：构建期把 git 采集结果写入 obj 下的资源文件，并以嵌入资源编入程序集；
    运行期只读该资源（Helpers/AppVersion.cs），因此运行时不需要 git、也不使用时间戳，
    同一份源码在任何机器上得到的版本一致。采集脚本见 BuildScripts/Get-BuildVersionInfo.ps1。
    采集失败（无 git / 无 PowerShell / 非 git 目录）时不中断构建，运行期回退到 +src.unknown。
  -->
  <Target Name="GenerateBuildVersionInfo" DependsOnTargets="ReadMsixIdentityVersion" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_BuildVersionInfoPath>$(IntermediateOutputPath)BuildVersionInfo.txt</_BuildVersionInfoPath>
      <_BuildVersionInfoArgs>-NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)BuildScripts\Get-BuildVersionInfo.ps1" -BaseVersion "$(_MsixIdentityVersion)" -StartDir "$(MSBuildProjectDirectory)" -ManifestPath "$(MSBuildProjectDirectory)\Package.appxmanifest" -OutputPath "$(_BuildVersionInfoPath)"</_BuildVersionInfoArgs>
    </PropertyGroup>
    <!-- 优先 pwsh，PATH 里没有时回退到 Windows 自带的 powershell.exe -->
    <Exec Command="pwsh $(_BuildVersionInfoArgs) || powershell.exe $(_BuildVersionInfoArgs)"
          ContinueOnError="true" IgnoreExitCode="true" />
    <Message Condition="!Exists('$(_BuildVersionInfoPath)')" Importance="high"
             Text="未能生成动态版本资源 $(_BuildVersionInfoPath)，运行时将回退到 +src.unknown。" />
    <!-- 把动态版本号读回 MSBuild 属性，供 DeriveAssemblyVersionFromMsixManifest 写入 exe 的文件版本/产品版本 -->
    <ReadLinesFromFile File="$(_BuildVersionInfoPath)" Condition="Exists('$(_BuildVersionInfoPath)')">
      <Output TaskParameter="Lines" ItemName="_BuildVersionInfoLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_BuildVersionInfoLine>@(_BuildVersionInfoLines)</_BuildVersionInfoLine>
      <!-- 资源行格式 base|commits|commit|[delta]，第一段即动态版本号 -->
      <_DynamicVersion>$([System.Text.RegularExpressions.Regex]::Match($(_BuildVersionInfoLine), '^[^|]+').Value)</_DynamicVersion>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_BuildVersionInfoPath)')">
      <EmbeddedResource Include="$(_BuildVersionInfoPath)">
        <LogicalName>GalgameManager.BuildVersionInfo.txt</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

